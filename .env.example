# mem-port configuration.
#
# Copy to .env for local development:   cp .env.example .env
# .env is gitignored; this file is the committed reference.
#
# Every value here is also a plain environment variable. Real environment
# variables always win over .env, so a deployed container needs no .env at all —
# it takes its configuration from the platform (Cloud Run env vars, Secret
# Manager). See deployments/ for that.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port to listen on. PORT is also honoured, since container platforms inject it.
MEM_PORT_PORT=8787

# Interface to bind.
#
# 127.0.0.1 (the default) is a security boundary, not a preference: mem-port has
# NO authentication of its own. The library-id header selects a tenant; it does
# not prove a right to that tenant. Anything that can reach this port can read
# and write any library by naming it.
#
# Set 0.0.0.0 only where something else enforces who may connect — a platform
# auth layer, a private network, or an authenticating proxy.
MEM_PORT_HOST=127.0.0.1

# Where the embedded database and the cached embedding model live.
# MEM_PORT_DATA_DIR=/var/lib/mem-port

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Default: an embedded SurrealDB file under the data dir. Nothing to run, no
# network. Leave the rest of this section commented out to use it.
# MEM_PORT_DB_URL=surrealkv:///var/lib/mem-port/memport.db

# --- Hosted SurrealDB ---
#
# Required for any deployment where the filesystem is ephemeral or more than one
# instance runs (Cloud Run, Kubernetes): the embedded engine would lose data on
# restart and let instances diverge.
#
# Three constraints, all checked at startup:
#   * server 3.0.0 or newer  — sessions and transactions are 3.0 features
#   * ws:// or wss:// only   — the HTTP engine supports neither, at any version
#   * a root- or namespace-level user — mem-port creates a database per
#     library-id and defines its schema on first use
#
# MEM_PORT_DB_URL=wss://your-instance.example.com
# MEM_PORT_DB_USER=root
# MEM_PORT_DB_PASS=change-me
#
# Or a bearer token instead of user/password (mutually exclusive with them):
# MEM_PORT_DB_TOKEN=

# Namespace holding one database per library-id.
# MEM_PORT_DB_NAMESPACE=memport

# Prefix for tenant database names, on a cluster shared with other applications.
# MEM_PORT_DB_PREFIX=

# Cached per-library sessions before the least recently used is closed. Each is
# server-side state, and this is PER INSTANCE — with N instances the cluster
# sees up to N times this number. Lower it when running many instances.
# MEM_PORT_DB_MAX_SESSIONS=256

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------

# Where the local ONNX model is cached. In a container, point this at weights
# baked in at build time so a cold start does not download them.
# MEM_PORT_MODEL_CACHE_DIR=/app/models

# MEM_PORT_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# UI
# ---------------------------------------------------------------------------

# Set to 0 to stop the read tools declaring an MCP Apps UI resource.
# MEM_PORT_MCP_APPS=1
