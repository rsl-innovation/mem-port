{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  // src/mcp/ui/{app,render}.ts are browser sources typechecked by
  // tsconfig.ui.json with DOM libs; generated.ts is theirs bundled into a
  // string and IS part of the node build.
  "exclude": ["node_modules", "dist", "test", "src/mcp/ui/app.ts", "src/mcp/ui/render.ts"]
}
